# Normalise every text file to LF in the working tree on every platform, so
# the SHA-256 digests in the deposited run records are checkout-stable.
* text=auto eol=lf

# Binary archives and images.  No binary file is tracked today; the
# wider-validation downloads are fetched by hash and are untracked.
*.gz binary
*.xz binary
*.zip binary
*.png binary
*.pdf binary
